import pandas as pd
import matplotlib.pyplot as plt

# اقرأ الـ CSV الذي أنشأته
df = pd.read_csv("results/hdafa_baselines_gemini.csv")

summary = df.groupby('system').agg(
    pass_rate=('verdict', lambda x: (x == 'PASS').mean() * 100),
    avg_coverage=('coverage', 'mean'),
    avg_time=('time', 'mean')
).round(2).reset_index()

# رتّب بنفس ترتيب الورقة
order = ['HDAFA', 'Multi-No-Validator', 'Single-Agent', 'Single+Validator']
summary['system'] = pd.Categorical(summary['system'], categories=order, ordered=True)
summary = summary.sort_values('system')

# ارسم
fig, axes = plt.subplots(1, 3, figsize=(15, 4))
colors = ['#d9954a', '#888', '#888', '#888']

axes[0].bar(summary['system'], summary['pass_rate'], color=colors)
axes[0].set_title('Pass Rate (%)', fontsize=12, fontweight='bold')
axes[0].set_ylim(0, 105)
axes[0].tick_params(axis='x', rotation=45)

axes[1].bar(summary['system'], summary['avg_coverage'], color=colors)
axes[1].set_title('Avg Coverage (%)', fontsize=12, fontweight='bold')
axes[1].set_ylim(0, 105)
axes[1].tick_params(axis='x', rotation=45)

axes[2].bar(summary['system'], summary['avg_time'], color=colors)
axes[2].set_title('Avg Time (s)', fontsize=12, fontweight='bold')
axes[2].tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.savefig('results/results_chart.png', dpi=150, bbox_inches='tight')
plt.show()
print("✅ results_chart.png created")
